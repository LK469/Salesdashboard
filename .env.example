# Copy to .env and fill in the values for whichever data source you're using.
# The backend reads these. The frontend never sees them.

# ===== Choose a data source =====
# mock        — synthetic sample data (default, runs offline)
# excel       — local .xlsx file (set EXCEL_FILE_PATH)
# sharepoint  — fetch the .xlsx from SharePoint / OneDrive (set SP_* below)
# salesforce  — live SF query (set SF_* below)
DATA_SOURCE=mock

# ===== Excel (local file) =====
# Absolute path to your BDR V2.xlsx. On Windows, use forward slashes or escape backslashes.
EXCEL_FILE_PATH=C:/Users/LavanKalaichelvam/Downloads/BDR V2.xlsx

# ===== SharePoint / OneDrive (Microsoft Graph) =====
# Azure AD app registration (App-only / client credentials flow)
SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=
# For personal OneDrive (one of SP_DRIVE_USER or SP_SITE_ID is required):
SP_DRIVE_USER=lavan.k@wellnessliving.com
# For a SharePoint site library (leave SP_DRIVE_USER unset if using this):
# SP_SITE_ID=wellnessliving.sharepoint.com,xxx,yyy
# Path to the file inside the drive (no leading slash).
SP_FILE_PATH=Documents/BDR V2.xlsx

# ===== Salesforce =====
SF_LOGIN_URL=https://login.salesforce.com
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
# OR OAuth2 refresh-token flow (preferred for production):
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REFRESH_TOKEN=
SF_INSTANCE_URL=

# Backend port
PORT=8787
